{
  "name": "vimcraft",
  "version": "0.1.11",
  "description": "**Status**: ✅ Zig executes JavaScript via Hermes + JSI bridge working",
  "main": "init.js",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "zig build test",
    "test:e2e": "failed=0; for dir in tests/e2e/*/; do ./zig-out/bin/vimc test \"$dir\" || failed=1; done; exit $failed",
    "build:config": "tsc --project tsconfig.json",
    "watch:config": "tsc --project tsconfig.json --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimcraft-labs/vimcraft.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vimcraft-labs/vimcraft/issues"
  },
  "homepage": "https://github.com/vimcraft-labs/vimcraft#readme",
  "devDependencies": {},
  "packageManager": "yarn@4.10.3"
}
