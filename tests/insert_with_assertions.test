# Test with assertions - verify correct behavior

LOAD /tmp/test_vimcraft.txt

# Verify initial state
ASSERT_LINES 3
ASSERT_CURSOR 0 0
ASSERT_MODE NORMAL
ASSERT_LINE 0 Hello World!

# Move to line 2
CMD j
ASSERT_CURSOR 1 0

# Move to end of line
CMD $
ASSERT_CURSOR 1 18

# Enter insert mode
CMD i
ASSERT_MODE INSERT

# Type "XXX"
CMD X
CMD X
CMD X

# Verify cursor moved
ASSERT_CURSOR 1 21

# Verify line content
ASSERT_LINE 1 This is a test filXXXe

# Exit insert mode
CMD ESC
ASSERT_MODE NORMAL

# Show final state
DUMP
DISPLAY 80
