# Test case for line wrap bug
# When typing at end of line 2, text should NOT appear on line 3

# Load the test file
LOAD /tmp/test_vimcraft.txt

# Show initial state
DUMP

# Go to line 2 (press j once)
CMD j
DUMP

# Go to end of line (press A)
CMD A
DUMP

# Type some text
CMD d
CMD l
CMD k
CMD f
CMD
CMD j
CMD s
CMD d
CMD l
CMD f
CMD j
CMD k
CMD e

# Show state after typing
DUMP

# Show what display would look like with 80 column terminal
DISPLAY 80

# Show with narrower terminal (40 cols)
DISPLAY 40
