{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "src/cli/vim.d.ts",
    "init.ts"
  ],
  "exclude": ["node_modules", "dist", "vendor", "zig-out", "zig-cache"]
}
